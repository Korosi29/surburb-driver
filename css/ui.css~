/* ui.css — Menu overlay and loading screen */

/* Desktop block — shown on screens wider than 480px */
.desktop-block {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #111;
    z-index: 9999;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    color: white;
    font-family: Sans-Serif;
}

.desktop-block p {
    font-size: 1.2rem;
    margin-top: 16px;
    color: #aaa;
}

@media (min-width: 480px) {
    .desktop-block {
        display: flex;
    }
}

.menu-con {
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), #d9f0fe;
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.menu-inner-con {
    width: 100%;
    height: 360px;
    background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
        url("../assets/images/main.jpg");
    background-size: cover;
    background-repeat: no-repeat;
}

.play,
.about {
    background-color: white;
    width: 60%;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 30px;
    font-size: 2.3rem;
    font-weight: bold;
    border: 2px solid black;
    border-radius: 10px;
    color: black;
    font-family: Sans-Serif;
}

.play {
    margin-top: 55px;
}

.about {
    font-size: 1.3rem;
}

.kgames {
    position: fixed;
    bottom: 20px;
    left: 0;
    right: 0;
    margin: auto;
    color: white;
    font-size: 0.75em;
}

/* Loading screen */
.loading-main {
    background-color: #d9f0fe;
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    text-align: center;
    	display: none;
}

.loading-inner {
    width: 100%;
    height: 360px;
    background-image: url("../assets/images/main.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    animation: appear 2.57s 1 forwards;
}

.loading-bar-con {
    width: 80%;
    height: 25px;
    left: 0;
    right: 0;
    position: relative;
    border: 1px solid black;
    bottom: -60px;
    margin-bottom: 10px;
}

.loading-bar {
    height: 100%;
    background-color: black;
    animation: loading-anim 7s 1 forwards;
}

.loading-text {
    font-size: 1.1em;
    font-weight: bold;
    text-align: center;
}

.version-number {
    font-size: 0.75em;
}

/* Animations */
@keyframes appear {
    0%   { filter: opacity(0); }
    30%  { filter: opacity(0); }
    100% { filter: opacity(1); }
}

@keyframes loading-anim {
    0%   { width: 0; }
    100% { width: 100%; }
}
