/* car1.css — Player car (Car 1) styles and lighting effects */

#c1-container {
    display: block;
    position: absolute;
    width: 80px;
    top: 60%;
    left: 158px;   /* right lane default */
}

#car1 {
    position: absolute;
    width: 100%;
}

/* Headlights — at the front (top) of car */
.c1-headlight-left,
.c1-headlight-right {
    display: none;
    width: 6px;
    height: 6px;
    background-color: #e3e3ff;
    position: absolute;
    top: 10px;
    left: 12px;
    box-shadow:
        0 -40px 25px 4px rgba(255, 255, 255, 0.4),
        0 -60px 18px 8px rgba(255, 255, 255, 0.7),
        0 -80px 18px 4px rgba(255, 255, 255, 0.6),
        0px -100px 18px 4px rgba(255, 255, 224, 0.3);
    filter: blur(2px) brightness(1);
}

.c1-headlight-right {
    left: 63px;
}

.on-low-beam-headlight {
    display: block;
}

.on-full-beam-headlight {
    box-shadow:
        0 -40px 25px 4px rgba(255, 255, 255, 0.8),
        0 -70px 18px 8px rgba(255, 255, 255, 1),
        0 -90px 18px 12px rgba(255, 255, 255, 1),
        0px -100px 18px 6px rgba(255, 255, 224, 0.8);
    filter: blur(2px) brightness(2.5);
}

/* Turn signals */
.c1-turn-sig-front-left,
.c1-turn-sig-back-left,
.c1-turn-sig-front-right,
.c1-turn-sig-back-right {
    display: none;
    width: 3px;
    height: 3px;
    background-color: yellow;
    position: absolute;
    top: 20px;
    left: 10px;
    box-shadow: -8px -8px 25px 8px rgba(255, 255, 0, 0.7);
    filter: blur(1px) brightness(2);
    animation: turn-sig-blink 0.75s infinite steps(2);
}

.c1-turn-sig-back-left {
    top: auto;
    bottom: -167px;
    left: 15px;
    box-shadow: -8px 8px 25px 8px rgba(255, 255, 0, 0.7);
}

.c1-turn-sig-front-right {
    top: 20px;
    left: auto;
    right: 10px;
    box-shadow: 8px -8px 25px 8px rgba(255, 255, 0, 0.7);
}

.c1-turn-sig-back-right {
    top: auto;
    bottom: -167px;
    left: auto;
    right: 14px;
    box-shadow: 8px 8px 25px 8px rgba(255, 255, 0, 0.7);
}

.on-turn-sig {
    display: block;
}

/* Tail lights — at the back (bottom) of car */
.c1-mid-tail-light {
    position: absolute;
    width: 10px;
    height: 1px;
    background-color: darkred;
    bottom: -171px;
    left: 35px;
}

.c1-tail-light-left,
.c1-tail-light-right {
    display: non;
    width: 3px;
    height: 2px;
    background-color: darkred;
    position: absolute;
    bottom: -167px;
    left: 14px;
    box-shadow: 0px 60px 60px 6px rgba(255, 0, 0, 0.9);
    filter: blur(2px) brightness(2.7);
}

.c1-tail-light-right {
    left: auto;
    right: 14px;
}

.c1-brake-blink {
    animation: brake-blink 1.2s infinite steps(2, start);
}

/* Animations */
@keyframes turn-sig-blink {
    0%   { display: none; }
    100% { display: block; }
}

@keyframes brake-blink {
    0%   { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    5%   { box-shadow: 0px 50px 50px 8px rgba(255, 0, 0, 0);   filter: blur(0) brightness(1); }
    10%  { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    15%  { box-shadow: 0px 50px 50px 8px rgba(255, 0, 0, 0);   filter: blur(0) brightness(1); }
    20%  { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    25%  { box-shadow: none; filter: blur(0) brightness(1); }
    30%  { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    35%  { box-shadow: none; filter: blur(0) brightness(1); }
    40%  { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    45%  { box-shadow: none; filter: blur(0) brightness(1); }
    50%  { box-shadow: 0px 30px 30px 8px rgba(255, 0, 0, 0.9); filter: blur(1px) brightness(2.7); }
    55%  { box-shadow: none; filter: blur(0) brightness(1); }
    100% { box-shadow: none; filter: blur(0) brightness(1); }
}
